{
  // Shared settings. Each page is its own classic-script project (pages do not
  // share globals except shared.ts): tsconfig.{app,edge,companion}.json.
  // The compiled .js files sit next to the HTML and are committed, so building
  // the Rust app never needs Node. `npm run build` regenerates them.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": ".",
    "strict": true,
    "noEmitOnError": true,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "files": []
}
